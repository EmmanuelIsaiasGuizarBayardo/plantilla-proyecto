cff-version: 1.2.0
message: "Si usas este proyecto en un trabajo académico, cítalo así."
title: "{{ nombre_proyecto }}"
abstract: "{{ descripcion | replace('\\', '\\\\') | replace('"', '\\"') }}"
type: software
{%- if contenido_didactico %}
license:
  - MIT
  - CC-BY-4.0
{%- else %}
license: MIT
{%- endif %}
{%- if organizacion_github %}
repository-code: "https://github.com/{{ organizacion_github }}/{{ nombre_dist }}"
{%- endif %}
version: "0.1.0"

# Autores: quienes aparecen al citar. Cada uno tiene su sección en CREDITS.md
# con el mismo nombre; tests/test_gobernanza.py verifica la correspondencia.
authors:
  - given-names: "{{ (autor_nombres or '[COMPLETAR: nombres]') | replace('"', '\\"') }}"
    family-names: "{{ (autor_apellidos or '[COMPLETAR: apellidos]') | replace('"', '\\"') }}"
{%- if proyecto_dunne %}
    affiliation: "{{ org_nombre_completo }}"
{%- endif %}

# Datos y software de terceros: su referencia formal vive solo aquí.
# references:
#   - type: data
#     title: "Título del dataset"
#     doi: "10.xxxx/..."   # con versión, si el repositorio versiona sus DOI
#     license: CC0-1.0
#     authors:
#       - family-names: "Apellido"
#         given-names: "Nombre"
